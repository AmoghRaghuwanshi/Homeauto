{
  "name": "home-auto-server",
  "version": "2.0.0",
  "description": "Home Automation & Security Dashboard Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node scripts/operator.js",
    "tls:setup": "node scripts/tls-setup.js",
    "recovery": "node scripts/recovery.js",
    "benchmark:speech": "node scripts/benchmark-speech.js",
    "test": "node --test --test-concurrency=1 tests/core.test.js tests/http.test.js tests/tls.test.js tests/remediation.test.js tests/cloud.test.js tests/online.test.js tests/online-safety.test.js tests/online-client.test.js tests/publication.test.js tests/signup.test.js tests/onboarding.test.js",
    "test:online": "node --test --test-concurrency=1 tests/online.test.js tests/online-safety.test.js tests/online-client.test.js",
    "test:online-staging": "node scripts/online-staging-check.js --apply",
    "test:cloud": "node --test tests/cloud.test.js",
    "test:cloud-staging": "node scripts/cloud-staging-check.js",
    "cloud": "node scripts/cloud.js",
    "test:browser": "node scripts/browser-check.js",
    "test:mobile": "node scripts/mobile-check.js",
    "test:signup": "node scripts/signup-browser-check.js",
    "test:ux": "node scripts/ux-check.js",
    "test:remediation": "node scripts/remediation-check.js",
    "test:voice-browser": "node scripts/native-browser-check.js",
    "preview:isolated": "node scripts/preview.js",
    "test:speech": "node scripts/speech-check.js",
    "test:onboarding": "node scripts/onboarding-browser-check.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "mqtt": "^5.10.0",
    "pg": "^8.23.1",
    "selfsigned": "^5.5.0",
    "sql.js": "^1.11.0",
    "vosk": "^0.3.39",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0"
  }
}
