{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": false },
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "fluid": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "excludeFiles": "{.local,firmware,docs,HomeAuto_UIUX_Docs,server/voice/models,server/certs,server/tests,server/db,server/node_modules}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=:path*" },
    { "source": "/((?!api/|assets/|css/|js/|manifest.json|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "microphone=(),camera=(),geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self';script-src 'self';style-src 'self';connect-src 'self';img-src 'self' data:;font-src 'self';media-src 'self' blob:;object-src 'none';base-uri 'self';frame-ancestors 'none';form-action 'self'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
