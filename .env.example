# Vercel project settings: configure separately for Development, Preview and Production.
# APP_BASE_URL must be the exact HTTPS origin. No actual domain or credential is supplied.
APP_BASE_URL=
ALLOWED_ORIGINS=
DATABASE_URL=
# Reviewed operator migrations only; never required by the browser or local gateway.
DATABASE_URL_UNPOOLED=
HOMEAUTO_ONLINE_ADMIN_APPROVED=0
HOMEAUTO_EXPECTED_DATABASE=
HOMEAUTO_ONLINE_STAGING_APPROVED=0
HOMEAUTO_EXPECTED_STAGING_HOST=
HOMEAUTO_CLOUD_REMOTE_LIGHTS_ENABLED=0
HOMEAUTO_REMOTE_LIGHTS_APPROVED=0

# Local gateway secrets stay in the household service's private environment, not Vercel public variables.
HOMEAUTO_GATEWAY_ENABLED=0
HOMEAUTO_GATEWAY_CONSENT=
HOMEAUTO_HOUSEHOLD_ID=
HOMEAUTO_GATEWAY_ID=
HOMEAUTO_GATEWAY_TOKEN=
HOMEAUTO_GATEWAY_ORIGIN=
HOMEAUTO_REMOTE_LIGHTS_ENABLED=0
HOMEAUTO_SECURE_GATEWAY_APPROVED=0
HOMEAUTO_DOOR_ENABLED=0

# One-time cloud operator process only; never browser variables or committed real values.
HOMEAUTO_CLOUD_OPERATOR_PASSWORD=
