# TEMPLATE ONLY. Do not put real secrets in this file or enable it on the household hub.
# Cloud API: separate Node.js process behind an HTTPS reverse proxy.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
HOMEAUTO_CLOUD_PORT=4000
HOMEAUTO_CLOUD_HUBS_FILE=
# Only set to 1 in the operator environment for a reviewed migration invocation.
HOMEAUTO_CLOUD_MIGRATION_APPROVED=0

# Local hub: opt-in catalog mirror. No database credential belongs on the hub.
HOMEAUTO_CLOUD_SYNC_ENABLED=0
HOMEAUTO_CLOUD_CONSENT=
HOMEAUTO_HOUSEHOLD_ID=
HOMEAUTO_HUB_ID=
HOMEAUTO_CLOUD_ORIGIN=
HOMEAUTO_HUB_TOKEN=
# Existing physical safety gate stays OFF.
HOMEAUTO_DOOR_ENABLED=0
