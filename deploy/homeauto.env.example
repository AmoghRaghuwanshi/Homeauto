# Set environment variables in the service manager or a private terminal.
# HomeAuto does not auto-load this file. Never commit a populated copy.
HOMEAUTO_HOST=127.0.0.1
HOMEAUTO_PORT=3000
HOMEAUTO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
HOMEAUTO_MQTT_ENABLED=0
HOMEAUTO_MQTT_BROKER=mqtts://localhost:8883
HOMEAUTO_MQTT_USERNAME=homeauto-hub
HOMEAUTO_MQTT_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
HOMEAUTO_MQTT_CA=C:\private\broker-ca.crt
HOMEAUTO_DOOR_ENABLED=0
HOMEAUTO_VOICE_ENABLED=1
